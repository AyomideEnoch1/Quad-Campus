rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /following/{targetUid} {
        allow read, write: if isSignedIn();
      }
      match /followers/{targetUid} {
        allow read, write: if isSignedIn();
      }
      match /profileLikes/{likerUid} {
        allow read, write: if isSignedIn();
      }
    }

    // 2. Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();

      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn();
      }
    }

    // 3. Marketplace Collection
    match /marketplace_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // 4. Direct Chats & Messages
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // 5. Clubs & Group Messages
    match /clubs/{clubId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();

      match /members/{memberId} {
        allow read, write: if isSignedIn();
      }

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // 6. Notifications Collection
    match /notifications/{notifId} {
      allow read, write: if isSignedIn();
    }

    // 7. Ads & Impressions
    match /ads/{adId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /ad_impressions/{impressionId} {
      allow read, write: if isSignedIn();
    }

    match /audit_log/{logId} {
      allow read, write: if isSignedIn();
    }
  }
}
